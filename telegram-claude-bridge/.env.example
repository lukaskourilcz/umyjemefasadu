# Telegram bot token from @BotFather.
# NOTE: rotate the token you pasted into chat earlier before using it here.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs allowed to run tasks.
# Find yours by messaging @userinfobot on Telegram. ONLY these users are accepted.
ALLOWED_TELEGRAM_USER_IDS=

# Anthropic API key. Leave EMPTY to use your Claude subscription (OAuth) instead
# and avoid per-token API charges.
ANTHROPIC_API_KEY=

# Optional: model alias or id (default: opus -> latest Opus)
CLAUDE_MODEL=opus

# Optional: spend cap per task in USD (default: 5)
MAX_BUDGET_USD=5

# Optional: max agent turns per task (default: 40)
MAX_TURNS=40
